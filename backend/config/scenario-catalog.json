{
  "version": "1.0.0",
  "scenarios": [
    {
      "scenarioId": "button-failure",
      "label": "Button failure",
      "targetComponent": "button",
      "severity": "high",
      "targetFiles": ["public/button.js"],
      "injection": {
        "type": "replace_text",
        "steps": [
          { "file": "public/button.js", "find": "count = nextCount(count);", "replace": "count = count;" }
        ]
      },
      "reversal": {
        "type": "replace_text",
        "steps": [
          { "file": "public/button.js", "find": "count = count;", "replace": "count = nextCount(count);" }
        ]
      },
      "expectedRepairAction": {
        "actionType": "replace_text",
        "targetFile": "public/button.js",
        "change": { "find": "count = count;", "replace": "count = nextCount(count);" }
      }
    },
    {
      "scenarioId": "layout-corruption",
      "label": "Layout corruption",
      "targetComponent": "layout",
      "severity": "medium",
      "targetFiles": ["public/layout.css"],
      "injection": {
        "type": "replace_text",
        "steps": [
          { "file": "public/layout.css", "find": "display: grid;", "replace": "display: inline;" }
