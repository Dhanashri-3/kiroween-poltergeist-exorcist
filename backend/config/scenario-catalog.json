      "reversal": {
        "type": "replace_text",
        "steps": [
          { "file": "public/card.css", "find": "background: #ffffff; display: none;", "replace": "background: #ffffff;" }
        ]
      },
      "expectedRepairAction": {
        "actionType": "replace_style_rule",
        "targetFile": "public/card.css",
        "change": { "find": " display: none;", "replace": "" }
      }
    },
