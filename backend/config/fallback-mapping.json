{
  "version": "1.0.0",
  "entries": [
    {
      "entryId": "fm-click-count-not-incremented",
      "evidencePattern": { "healthCheckId": "button", "status": "fail", "errorPattern": "^click handler produced" },
      "sourceCheck": { "file": "public/button.js", "contains": "count = count;" },
      "diagnosisTemplate": {
        "component": "button",
        "suspectedFile": "public/button.js",
        "location": "click handler inside mount()",
        "rootCause": "The click handler assigns the counter to itself instead of calling nextCount, so the click count never changes.",
        "confidence": 0.9
      },
      "planTemplate": {
        "actionType": "replace_text",
        "targetFile": "public/button.js",
        "change": { "find": "count = count;", "replace": "count = nextCount(count);" },
        "rationale": "Call nextCount so each click increments the counter."
      }
    },
    {
      "entryId": "fm-layout-display-not-grid",
      "evidencePattern": { "healthCheckId": "layout", "status": "fail", "errorPattern": "^\\.layout-section display is" },
      "sourceCheck": { "file": "public/layout.css", "contains": "display: inline;" },
      "diagnosisTemplate": {
        "component": "layout",
        "suspectedFile": "public/layout.css",
        "location": ".layout-section rule",
        "rootCause": "The .layout-section rule uses an inline display value, which breaks the two-column grid layout.",
        "confidence": 0.9
      },
      "planTemplate": {
        "actionType": "replace_style_rule",
        "targetFile": "public/layout.css",
        "change": { "find": "display: inline;", "replace": "display: grid;" },
        "rationale": "Restore display: grid on the layout section."
      }
    },
